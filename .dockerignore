# Keeps the build context small and fast. Neither service's Dockerfile
# actually needs any of this copied in, raw_data/, cleaned_data/, and
# outputs/ are mounted in as volumes at runtime instead (see
# docker-compose.yml), and everything else here is either real customer
# data, git history, or local dev clutter that has no business being
# baked into an image.
.git/
raw_data/
cleaned_data/
outputs/
assets/
tests/
.pytest_cache/
__pycache__/
**/__pycache__/
*.pyc
.venv/
venv/
warehouse/*.duckdb
dbt_seamark/target/
dbt_seamark/logs/
dbt_seamark/dbt_packages/
.env
**/.env
supabase/
stock_alerts/
# shopify_sync/ used to be excluded too -- api/'s Dockerfile never
# needed it. shopify_sync/Dockerfile (the webhook listener) does,
# so it can't be blanket-ignored here any more.
