__pycache__/
*.pyc
.pytest_cache/
.DS_Store

# pipeline.py's own run log — overwritten every run, not project data
pipeline_run.log

# Virtual environment
.venv/
venv/

# Secrets — never commit these (see supabase/.env.example, dashboard/.env.example,
# stock_alerts/.env.example, shopify_sync/.env.example)
.env
supabase/.env
dashboard/.env
stock_alerts/.env
stock_alerts/weekly_check.log
shopify_sync/.env
.streamlit/secrets.toml

# Real customer personal data — never commit these (names/emails from real
# customers). Regenerate locally with `python shopify_sync/refresh_raw_data.py`
# (see shopify_sync/README.md) or a manual Shopify export — see DATA_PROVENANCE.md.
# cleaned_data/*_clean.csv are derived from the raw_data files below by
# analytics/01_data_cleaning.py and carry the same Email/Name columns forward,
# so they need the same treatment — regenerate locally with `python pipeline.py`.
raw_data/customers_export.csv
raw_data/orders_export.csv
cleaned_data/customers_clean.csv
cleaned_data/orders_clean.csv

# warehouse/build_duckdb.py loads customers_clean.csv and orders_clean.csv
# (see above) into this file too, so it carries the same real customer
# data and needs the same treatment -- never commit it. It's derived and
# rebuildable anyway: `python warehouse/build_duckdb.py` regenerates it
# from the CSVs in seconds.
warehouse/*.duckdb
warehouse/*.duckdb.wal

# dbt's own working files -- compiled SQL, run logs, downloaded packages.
# None of this is something to commit, dbt regenerates all of it from
# dbt_seamark/models/ on every run.
dbt_seamark/target/
dbt_seamark/logs/
dbt_seamark/dbt_packages/
dbt_seamark/.user.yml

# Docker build cache / local overrides some Compose setups create
.docker/

# webhook_listener.py lands every real order event here as raw JSON,
# unprocessed -- that JSON carries the same real customer data as
# orders_export.csv above (name, email, address), so it gets the exact
# same treatment: never committed, regenerated by real traffic, not
# something to check in.
raw_data/webhook_events/
