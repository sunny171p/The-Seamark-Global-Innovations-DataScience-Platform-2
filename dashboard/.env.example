# Copy this file to dashboard/.env and fill in your real values to have the
# dashboard read from Supabase instead of the local CSVs.
#
# Use the anon/public key here — NEVER the service_role key. This file (or
# Streamlit secrets, if deployed on Streamlit Community Cloud) is read by
# the app that runs in the browser's request path; the anon key is meant
# to be used this way, the service_role key is not.

SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_ANON_KEY=your-anon-public-key

# If left unset, the dashboard automatically falls back to reading
# ../cleaned_data/ and ../outputs/ directly — no Supabase required to run it.
