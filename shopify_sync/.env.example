# Copy this file to shopify_sync/.env and fill in your real values.
#
# This needs the SAME Shopify custom app as stock_alerts/, but with MORE
# scopes ticked (Configuration > Admin API access scopes), because this
# reads orders and customers too, not just inventory:
#   read_products
#   read_orders
#   read_customers
#
# If you already created the custom app for stock_alerts/, you don't need
# a second one — go back into that same app (Settings > Apps and sales
# channels > Develop apps > your app > Configuration), tick the extra
# scopes above and save.
#
# Find your store domain in Shopify admin > Settings > Domains
# (the *.myshopify.com one, not a custom domain).
#
# TWO WAYS TO AUTHENTICATE — use whichever your app's page actually shows:
#
# Option A — your app's API credentials page shows a permanent token
# starting with shpat_ (older-style custom apps). Fill in just this one
# and leave the Client ID/Secret lines blank:
SHOPIFY_STORE_DOMAIN=your-store.myshopify.com
SHOPIFY_ADMIN_API_ACCESS_TOKEN=shpat_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
SHOPIFY_API_VERSION=2026-07

# Option B — your app's page only shows a Client ID and a Secret
# (starting with shpss_) instead — this is normal for apps made through
# Shopify's newer Dev Dashboard. Leave SHOPIFY_ADMIN_API_ACCESS_TOKEN
# blank above and fill these in instead; the script exchanges them for a
# real access token itself on every run (that exchanged token only lasts
# 24 hours, which is why it can't just be saved once):
# SHOPIFY_CLIENT_ID=your-client-id
# SHOPIFY_CLIENT_SECRET=shpss_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Only needed for webhook_listener.py (real-time order events instead of
# on-demand pulls). Shopify shows you this when you register a webhook
# in your app's Configuration > Webhook subscriptions page — for most
# custom apps it's the same value as SHOPIFY_CLIENT_SECRET above, but
# Shopify's page for your specific app is the source of truth, check
# there rather than assuming:
# SHOPIFY_WEBHOOK_SECRET=shpss_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
