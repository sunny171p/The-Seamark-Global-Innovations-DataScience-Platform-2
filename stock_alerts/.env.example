# Copy this file to stock_alerts/.env and fill in your real values.
# Never commit stock_alerts/.env — it holds real credentials.

# Shopify custom app (Settings > Apps and sales channels > Develop apps
# > Create an app > Configuration > Admin API scopes): tick
# read_products and read_inventory, click Install app, then copy the
# Admin API access token shown on the API credentials tab. It's only
# shown once — if you lose it, revoke and generate a new one.
SHOPIFY_STORE_DOMAIN=your-store.myshopify.com
SHOPIFY_ADMIN_API_ACCESS_TOKEN=shpat_your_real_token_here

# A current stable Shopify API version — check Shopify's API docs if
# check_stock.py ever errors with "Unsupported API version".
SHOPIFY_API_VERSION=2026-07

# Email alerts. For Gmail: turn on 2-Step Verification, then create an
# "App password" at myaccount.google.com/apppasswords and use that
# here — never your real Gmail account password.
ALERT_EMAIL_FROM=you@gmail.com
ALERT_EMAIL_TO=you@gmail.com
ALERT_EMAIL_APP_PASSWORD=your-16-character-app-password
SMTP_SERVER=smtp.gmail.com
SMTP_PORT=587
